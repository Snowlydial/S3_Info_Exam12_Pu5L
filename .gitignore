# Ignore Visual Studio temporary files, build results, and
# files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
.editorconfig

# User-specific folders
.vs/

# Build results
bin/
obj/

# Visual Studio auto-generated files
*.class
*.log
*.tlog
*.pdb
*.cache
*.ilk
*.idb

# Packages directory can be ignored unless you're checking in dependencies
packages/
*.nupkg
*.snupkg

# Other files to consider
*.tmp
*.log
*.vspscc
*.vssscc
