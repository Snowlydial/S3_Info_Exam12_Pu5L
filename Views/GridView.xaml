<UserControl x:Class="Exam12_Pu5L.Views.GridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- THE GRID -->
        <Grid x:Name="GameGrid" Grid.Column="0" VerticalAlignment="Stretch">
            <Grid.Background>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Canvas x:Name="GridBackground" IsHitTestVisible="False"/>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Grid.Background>
        </Grid>

        <!-- THE PLAYER INTERACTIVE MENU -->
        <Grid x:Name="PlayerInteract" Grid.Column="1" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
                <TextBlock FontSize="20" FontWeight="Bold" Text="Current Player's Turn:" />
                <TextBlock x:Name="PlayerTurn" FontSize="18" FontWeight="Medium" />
            </StackPanel>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="59,118,0,0">
                <TextBlock FontSize="20" FontWeight="Bold" Text="Scores:" />
                <TextBlock x:Name="P1_Score"  FontSize="18" FontWeight="Medium" />
                <TextBlock x:Name="P2_Score" FontSize="18" FontWeight="Medium" />
            </StackPanel>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="59,244,0,0">
                <TextBlock FontSize="20" FontWeight="Bold" Text="Limit:" />
                <TextBlock x:Name="P1_Limit"  FontSize="18" FontWeight="Medium" />
                <TextBlock x:Name="P2_Limit" FontSize="18" FontWeight="Medium" />
            </StackPanel>

            <DockPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,405,0,0" 
                Width="320">
                <Button x:Name="Option" Content="Options" 
                        DockPanel.Dock="Right"
                        Padding="10,5"
                        Click="Option_Click"/>
                <Button x:Name="Suggest" Content="Get a suggestion"
                        Padding="10,5" DockPanel.Dock="Bottom" Height="28"
                        Click="Suggest_Click"/>
            </DockPanel>

        </Grid>

        <!-- Options Popup -->
        <DockPanel x:Name="OptionsPanel" HorizontalAlignment="Center" VerticalAlignment="Center" 
               Background="AliceBlue" Width="200" Visibility="Collapsed">
            <StackPanel Orientation="Vertical" Margin="10">
                <Button x:Name="SaveButton" Content="Save" 
                        Margin="0,5"
                        Padding="10,5" 
                        Click="SaveButton_Click"/>
                <Button x:Name="LoadButton" Content="Load" 
                        Margin="0,5"
                        Padding="10,5"
                        Click="LoadButton_Click"/>
                <Button x:Name="RestartButton" Content="Restart" 
                        Margin="0,5"
                        Padding="10,5"
                        Click="Restart_Click"/>
                <Button x:Name="MenuButton" Content="Go to Menu" 
                        Margin="0,5"
                        Padding="10,5"
                        Click="Menu_Click"/>
                <Button x:Name="CancelButton" Content="Cancel" 
                        Margin="0,5"
                        Padding="10,5"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </DockPanel>

    </Grid>

</UserControl>