<Window x:Class="Exam12_Pu5L.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Exam12_Pu5L.Views"
        mc:Ignorable="d"
        Title="Puissance 5" Height="600" Width="800"
        Background="LightGray">
    <Grid>
        <StackPanel x:Name="Parent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White">
            <!-- Player section -->
            <StackPanel x:Name="PlayerSection" Orientation="Vertical" VerticalAlignment="Center" Background="LightBlue" Width="180">
                <TextBlock Text="Player Names:" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" />

                <!-- Player 1 Input -->
                <TextBlock Text="Player 1 Name:" FontSize="16" Margin="10,0" />
                <TextBox x:Name="Player1NameInput" Width="150" FontSize="16" Margin="10,0,0,10" />

                <!-- Player 2 Input -->
                <TextBlock Text="Player 2 Name:" FontSize="16" Margin="10,0" />
                <TextBox x:Name="Player2NameInput" Width="150" FontSize="16" Margin="10,0,0,10" />

                <!-- Alea: Point Limit -->
                <TextBlock Text="Move Limit:" FontSize="16" Margin="10,0" />
                <TextBox x:Name="LimitInput" Width="150" FontSize="16" Margin="10,0,0,10" />

                <Button x:Name="LoadGame" Content="Load Game" Click="LoadGame_Click" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- RowColumn section -->
            <StackPanel x:Name="RowColumnSection" Orientation="Vertical" VerticalAlignment="Center" Background="LightSlateGray" Width="180">
                <TextBlock Text="Grid Settings:" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" />

                <!-- Row Input -->
                <TextBlock Text="Number of Rows:" FontSize="16" Margin="10,0" />
                <TextBox x:Name="RowInput" Width="150" FontSize="16" Margin="10,0,0,10" />

                <!-- Column Input -->
                <TextBlock Text="Number of Columns:" FontSize="16" Margin="10,0" />
                <TextBox x:Name="ColumnInput" Width="150" FontSize="16" Margin="10,0,0,10" />
                <CheckBox x:Name="Continuous" HorizontalAlignment="Center" Content="Continuous Mode"/>
                <Button Content="Start Game" Click="StartGameButton_Click" Width="150" HorizontalAlignment="Center" Margin="10" />
            </StackPanel>
        </StackPanel>

        <views:GridView x:Name="GameGridView" Visibility="Collapsed"/>
    </Grid>
</Window>
